---
interface Props {
  active: 'home' | 'projects' | 'photos';
}
const { active } = Astro.props as Props;

const linkClass = (key: string) =>
  `font-mono text-xs uppercase tracking-wider ${active === key ? 'text-text' : 'text-text-dim hover:text-text'}`;
---
<nav class="flex flex-wrap items-center justify-between gap-4 px-8 md:px-16 py-7 border-b border-border max-w-6xl mx-auto">
  <a href="/" class="font-mono text-base font-semibold">tompkinstech<span class="text-ok">.</span>com</a>
  <div class="flex items-center gap-7">
    <a href="/" class={linkClass('home')}>Home</a>
    <a href="/projects" class={linkClass('projects')}>Projects</a>
    <a href="/photos" class={linkClass('photos')}>Photos</a>
    <a
      href="/admin/login"
      class="font-mono text-xs uppercase tracking-wider text-text border border-border rounded px-4 py-2 flex items-center gap-2"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="11" width="18" height="10" rx="2"></rect>
        <path d="M7 11V7a5 5 0 0 1 10 0v4"></path>
      </svg>
      Admin
    </a>
  </div>
</nav>
