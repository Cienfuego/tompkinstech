# Postgres
POSTGRES_PASSWORD=change-me

# Session signing — generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-a-long-random-string

# Generate with: node app/scripts/hash-password.mjs 'your-real-password'
ADMIN_PASSWORD_HASH=

# Alerts (sent via AWS SES)
ALERT_EMAIL_TO=you@example.com
ALERT_EMAIL_FROM=alerts@yourdomain.com
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Only needed once you've created a tunnel in the Cloudflare dashboard
CLOUDFLARE_TUNNEL_TOKEN=
